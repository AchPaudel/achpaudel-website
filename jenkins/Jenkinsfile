pipeline {
    agent any
    
    environment {
        PROJECT_NAME = 'achpaudel-website'
        DOCKER_IMAGE_BACKEND = 'achpaudel/backend'
        DOCKER_IMAGE_FRONTEND = 'achpaudel/frontend'
        DOCKER_TAG = "${env.BUILD_NUMBER}"
        DEPLOY_SCRIPT = '/opt/achpaudel-website/scripts/deploy.sh'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Checked out code from ${env.GIT_BRANCH}"
            }
        }
        
        stage('Backend Tests') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "**/*.java"
                    changeset "pom.xml"
                }
            }
            steps {
                dir('backend') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean test'
                }
            }
            post {
                always {
                    publishTestResults testResultsPattern: 'backend/target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Frontend Tests') {
            when {
                anyOf {
                    changeset "frontend/**"
                    changeset "**/*.ts"
                    changeset "**/*.js"
                    changeset "package.json"
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run test -- --watch=false --browsers=ChromeHeadless'
                    sh 'npm run lint'
                }
            }
            post {
                always {
                    publishTestResults testResultsPattern: 'frontend/coverage/**/*.xml'
                }
            }
        }
        
        stage('Build Backend') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "**/*.java"
                    changeset "pom.xml"
                }
            }
            steps {
                dir('backend') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package -DskipTests'
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }
        
        stage('Build Frontend') {
            when {
                anyOf {
                    changeset "frontend/**"
                    changeset "**/*.ts"
                    changeset "**/*.js"
                    changeset "package.json"
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build --prod'
                    archiveArtifacts artifacts: 'dist/**/*', fingerprint: true
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                script {
                    // Build backend image
                    if (fileExists('backend/Dockerfile')) {
                        docker.build("${DOCKER_IMAGE_BACKEND}:${DOCKER_TAG}")
                        docker.build("${DOCKER_IMAGE_BACKEND}:latest")
                    }
                    
                    // Build frontend image
                    if (fileExists('frontend/Dockerfile')) {
                        docker.build("${DOCKER_IMAGE_FRONTEND}:${DOCKER_TAG}")
                        docker.build("${DOCKER_IMAGE_FRONTEND}:latest")
                    }
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                script {
                    // Run security scans
                    if (fileExists('backend/pom.xml')) {
                        sh 'cd backend && ./mvnw dependency:check'
                    }
                    
                    if (fileExists('frontend/package.json')) {
                        sh 'cd frontend && npm audit --audit-level=moderate'
                    }
                }
            }
        }
        
        stage('Deploy to Staging') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    // Deploy to staging environment
                    sh "ssh ubuntu@staging.achpaudel.dev 'cd /opt/${PROJECT_NAME} && git pull origin develop'"
                    sh "ssh ubuntu@staging.achpaudel.dev 'cd /opt/${PROJECT_NAME} && ${DEPLOY_SCRIPT} deploy'"
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Deploy to production?', ok: 'Deploy'
                script {
                    // Deploy to production environment
                    sh "ssh ubuntu@achpaudel.dev 'cd /opt/${PROJECT_NAME} && git pull origin main'"
                    sh "ssh ubuntu@achpaudel.dev 'cd /opt/${PROJECT_NAME} && ${DEPLOY_SCRIPT} deploy'"
                }
            }
        }
        
        stage('Health Check') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                script {
                    // Wait for deployment to complete
                    sleep 60
                    
                    // Health checks
                    sh '''
                        # Check backend health
                        curl -f http://achpaudel.dev:8081/api/health || exit 1
        
                        # Check frontend
                        curl -f http://achpaudel.dev || exit 1
        
                        # Check SSL
                        curl -f https://achpaudel.dev || exit 1
                    '''
                }
            }
        }
    }
    
    post {
        always {
            // Clean up workspace
            cleanWs()
        }
        
        success {
            echo "Pipeline completed successfully!"
        }
        
        failure {
            echo "Pipeline failed!"
            // Send notification
            emailext (
                subject: "Pipeline Failed: ${env.JOB_NAME} - Build ${env.BUILD_NUMBER}",
                body: "Pipeline failed for ${env.JOB_NAME} build ${env.BUILD_NUMBER}. Check console output at ${env.BUILD_URL}",
                recipientProviders: [[$class: 'DevelopersRecipientProvider']]
            )
        }
        
        unstable {
            echo "Pipeline is unstable!"
        }
    }
} 